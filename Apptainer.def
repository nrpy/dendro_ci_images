Bootstrap: docker
From: ubuntu:24.04

%labels
    org.opencontainers.image.title "NRPy Dendro CPU CI toolchain"
    org.opencontainers.image.description "Ubuntu 24.04.5 CPU toolchain for NRPy-generated Dendro-GR modules"
    org.opencontainers.image.source "https://github.com/nrpy/nrpy"
    org.opencontainers.image.base.name "docker.io/library/ubuntu:24.04"

%files
    requirements.txt /opt/nrpy/requirements.txt

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get -y dist-upgrade
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        gfortran \
        git \
        libgsl-dev \
        liblapack-dev \
        libopenblas-dev \
        libopenmpi-dev \
        openmpi-bin \
        pkg-config \
        python3 \
        python3-venv \
        zlib1g-dev

    . /etc/os-release
    if [ "$VERSION" != "24.04.5 LTS (Noble Numbat)" ]; then
        echo "Expected Ubuntu 24.04.5 after package upgrade; found $VERSION" >&2
        exit 1
    fi

    python3 -m venv /opt/nrpy-venv
    /opt/nrpy-venv/bin/python -m pip install --no-cache-dir --upgrade pip
    /opt/nrpy-venv/bin/python -m pip install --no-cache-dir \
        -r /opt/nrpy/requirements.txt

    git init /opt/Dendro-GR
    git -C /opt/Dendro-GR remote add origin https://github.com/paralab/Dendro-GR.git
    git -C /opt/Dendro-GR fetch --depth 1 origin \
        b3261e2a0d3457781b11d63ac5ab38375ffab93b
    git -C /opt/Dendro-GR checkout --detach FETCH_HEAD

    git init /opt/Dendro-5.01
    git -C /opt/Dendro-5.01 remote add origin https://github.com/paralab/Dendro-5.01.git
    git -C /opt/Dendro-5.01 fetch --depth 1 origin \
        246043709e806021fcfc011fe657b8bf964cae4c
    git -C /opt/Dendro-5.01 checkout --detach FETCH_HEAD

    git clone --depth 1 --branch v4.4.0 \
        https://github.com/ToruNiina/toml11.git /opt/toml11
    git clone --depth 1 --branch v1.14.1 \
        https://github.com/gabime/spdlog.git /opt/spdlog

    test "$(git -C /opt/Dendro-GR rev-parse HEAD)" = \
        b3261e2a0d3457781b11d63ac5ab38375ffab93b
    test "$(git -C /opt/Dendro-5.01 rev-parse HEAD)" = \
      246043709e806021fcfc011fe657b8bf964cae4c

    # Keep Dendro Git metadata for writable-copy update workflows, but omit
    # source material unrelated to generated-module builds. Cached header-only
    # dependencies do not need their Git metadata at runtime.
    find /opt/Dendro-GR/doc /opt/Dendro-GR/fig \
        /opt/Dendro-5.01/docs /opt/toml11/.git /opt/spdlog/.git \
        -depth -delete

    git config --system --add safe.directory /opt/Dendro-GR
    git config --system --add safe.directory /opt/Dendro-5.01
    git config --system --add safe.directory /opt/toml11
    git config --system --add safe.directory /opt/spdlog

    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.cache

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/opt/nrpy-venv/bin:$PATH
    export DENDRO_GR_SOURCE=/opt/Dendro-GR
    export DENDROLIB_SOURCE=/opt/Dendro-5.01
    export TOML11_SOURCE=/opt/toml11
    export SPDLOG_SOURCE=/opt/spdlog

%help
    NRPy Dendro CPU CI toolchain.

    The image provides a Python virtual environment and pinned, read-only source
    templates. Copy the Dendro source trees to a writable work directory before
    adding or building an NRPy-generated solver module.
